# Chave de API do Google Gemini (para análise inteligente, resumos e conversão de prompts/skills)
# Obtém a tua chave em: https://aistudio.google.com/
GEMINI_API_KEY=o_teu_token_aqui

# Caminho para a base de dados SQLite (opcional, por defeito: repos.db)
# REPOS_DB_PATH=repos.db

# Porta do servidor (opcional, por defeito: 8000)
# PORT=8000
